{
  "expo": {
    "name": "PrayerCare",
    "slug": "prayercare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prayercare",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prayercare.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "PrayerCare",
        "NSUserNotificationsUsageDescription": "PrayerCare sends gentle reminders for daily prayer, care actions, and group updates.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.prayercare.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FAF9F7"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#5B7B6A",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "betaMode": false,
      "router": {},
      "eas": {
        "projectId": "83766463-33dc-4416-afc8-dd020334acc3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "kakam",
    "updates": {
      "url": "https://u.expo.dev/83766463-33dc-4416-afc8-dd020334acc3"
    }
