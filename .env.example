EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_LANDING_URL=https://www.prayercare.online
EXPO_PUBLIC_WEB_APP_URL=https://app.prayercare.online
EXPO_PUBLIC_BETA_MODE=false

# Freemium: leave unset/false for free public launch (everyone gets full access).
# Later, when introducing paid plans: EXPO_PUBLIC_SUBSCRIPTIONS_ENFORCED=true
# EXPO_PUBLIC_SUBSCRIPTIONS_ENFORCED=false

# Landing site (website/ folder on Vercel):
# APP_URL=https://app.prayercare.online
# SITE_URL=https://www.prayercare.online
# PRAYERCARE_BETA_MODE=false
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets):
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini  (optional)
#
# Optional — only if you add licensed translations via API.Bible later:
# API_BIBLE_KEY=your-api.bible-key
#
# fetch-scripture works without any secrets (uses free bible-api.com).
#
# Future Stripe (do not add until after free launch):
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
